#!/bin/sh

voice="${SPEAK_VOICE:?}"

usage() {
	cat <<-EOF
		usage: speak [-n NAME] [TEXT...]   read TEXT (or stdin) aloud
		  -n NAME   prepend NAME to the title, e.g. the calling program
		control playback with playerctl, e.g. play-pause, stop
	EOF
}

# NOTE: [AGENT]: keep piper from reading raw markdown. in order, drop fenced
# code blocks and table rows, unwrap [text](url) links, drop list markers,
# strip inline punctuation, turn underscores into spaces and drop lines left
# blank, so whitespace-only text comes out empty
# shellcheck disable=SC2016
strip_markdown() {
	sed -E \
		-e '/^[[:space:]]*```/,/^[[:space:]]*```/d' \
		-e '/^[[:space:]]*\|/d' \
		-e 's/\[([^]]*)\]\([^)]*\)/\1/g' \
		-e 's/^[[:space:]]*([-+*]|[0-9]+\.)[[:space:]]+//' \
		-e 's/[`*#>]+//g' \
		-e 'y/_/ /' \
		-e '/^[[:space:]]*$/d'
}

########
# MAIN #
########

name=""
while getopts "n:h" opt; do
	case "$opt" in
	n) name="$OPTARG" ;;
	h)
		usage
		exit 0
		;;
	*)
		usage 1>&2
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))

if [ "$#" -gt 0 ]; then
	text="$*"
else
	text="$(cat)"
fi
text="$(printf '%s\n' "$text" | strip_markdown)"
if [ -z "$text" ]; then
	exit 0
fi

wav="$(mktemp --suffix .wav)"
trap 'rm -f "$wav"' EXIT
trap 'exit 1' INT TERM HUP
printf '%s\n' "$text" | piper --model "$voice" --output-file "$wav" 2>/dev/null

title="$(printf '%s\n' "$text" | head -n 1 | cut -c 1-80)"
if [ -n "$name" ]; then
	title="$name - $title"
fi

# NOTE: [AGENT]: mpris Identity and the pipewire stream name
mpv --no-config --no-video --no-terminal --audio-client-name=Speak \
	--force-media-title="$title" "$wav"
